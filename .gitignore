/models/**
!/models/.gitkeep
*.safetensors
pytorch_model.bin
*.ckpt
*.pth
*.pt

# Generated training output
/outputs/**
!/outputs/.gitkeep

# Logs and temporary files
*.log
temp/

# Operating system files
.DS_Store
Thumbs.db
